{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "battery",
    "poweradapter",
    "disk",
    {
	"type": "physicaldisk",
	"temp": true
    },
    {
	"type": "cpu",
	"showPeCoreCount": true,
	"temp": true
    },
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}
